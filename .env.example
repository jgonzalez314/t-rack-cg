# Leave this file out entirely to run in local mode (no database, data saved
# in the browser).
#
# Copy this file to .env.local and fill in the values from
# Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to true to use local mode even when the keys above are filled in.
# NEXT_PUBLIC_LOCAL_MODE=true

# Optional. Raw cards show a suggested price from TCGplayer's market price,
# looked up through the free Pokemon TCG API (pokemontcg.io). It works with no
# key (about 1,000 lookups a day). A free key from https://dev.pokemontcg.io
# raises that to 20,000. Server only: do not prefix it with NEXT_PUBLIC_.
# POKEMONTCG_API_KEY=your-pokemontcg-key

# Optional. Keep synced data in Amazon DynamoDB instead of the Supabase
# database. Sign-in still uses the Supabase keys above. See "Using DynamoDB"
# in the README. The AWS values are server only.
# NEXT_PUBLIC_DATA_BACKEND=dynamodb
# DYNAMODB_TABLE=your-table-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
